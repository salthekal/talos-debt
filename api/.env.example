# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Connect as talos_api (member of talos_app), never as postgres: the API refuses to start otherwise.
DATABASE_URL=postgres://talos_api:talos_api_dev@localhost:5432/talos_dev
# The webhook connects as talos_jobs (member of talos_worker, sees all clients). Leave empty to turn the webhook off.
WORKER_DATABASE_URL=postgres://talos_jobs:talos_jobs_dev@localhost:5432/talos_dev
AUTH_MODE=dev
LOG_LEVEL=info

# WhatsApp Cloud API (from Meta: WhatsApp, API Setup). Never commit the token.
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
# From Meta: App settings, Basic, App secret. Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET=
# Any long random text. Enter the same value in Meta: WhatsApp, Configuration, Verify token.
WHATSAPP_VERIFY_TOKEN=
# Development only: every message goes to this number (yours), never to the fake debtors.
WHATSAPP_DEV_REDIRECT_TO=+9665XXXXXXXX
# Development only: Meta's test number can only send its own "hello_world" template
# until your own templates are approved. Remove this line once they are.
WHATSAPP_DEV_TEMPLATE=hello_world:en_US

# AI for the WhatsApp agent. AI_PROVIDER=none saves incoming messages without answering.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Free tier: fake data only. The server refuses AI_FREE_TIER=true in production.
AI_FREE_TIER=true
# Reply outside the client's working hours? Default false: the reply is held for staff.
AGENT_REPLY_OUTSIDE_HOURS=false

# Scheduler (npm run scheduler). Defaults shown.
SCHEDULER_POLL_SECONDS=30
SCHEDULER_BATCH_SIZE=20
SCHEDULER_PLAN_EVERY_SECONDS=300
SCHEDULER_STALE_MINUTES=10
# Daily summary for each client from this time, in the client's time zone, on working days.
DAILY_SUMMARY_TIME=08:00

# Uploaded files. Development keeps them in a local folder (ignored by git).
# Production: STORAGE_DRIVER=gcs and GCS_BUCKET (see docs/file-storage.md).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/files
GCS_BUCKET=
GCS_KMS_KEY=
MAX_UPLOAD_MB=10

# Start date of the new Enforcement Law (YYYY-MM-DD). Leave empty until it is published.
ENFORCEMENT_LAW_START_DATE=
