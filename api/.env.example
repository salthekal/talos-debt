# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Connect as talos_api (member of talos_app), never as postgres: the API refuses to start otherwise.
DATABASE_URL=postgres://talos_api:talos_api_dev@localhost:5432/talos_dev
AUTH_MODE=dev
LOG_LEVEL=info

# WhatsApp Cloud API (from Meta: WhatsApp, API Setup). Never commit the token.
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
# Development only: every message goes to this number (yours), never to the fake debtors.
WHATSAPP_DEV_REDIRECT_TO=+9665XXXXXXXX
# Development only: Meta's test number can only send its own "hello_world" template
# until your own templates are approved. Remove this line once they are.
WHATSAPP_DEV_TEMPLATE=hello_world:en_US
